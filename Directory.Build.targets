<Project>
  <PropertyGroup>
    <BG3SEPairSourceCommit Condition="'$(BG3SEPairSourceCommit)' == ''">$([System.Environment]::GetEnvironmentVariable('BG3SE_PAIR_SOURCE_COMMIT'))</BG3SEPairSourceCommit>
    <BG3SEPairIdentity Condition="'$(BG3SEPairSourceCommit)' != ''">bg3se-agent/$(BG3SEPairSourceCommit)</BG3SEPairIdentity>
  </PropertyGroup>

  <Target Name="ValidateBG3SEPairIdentity" Condition="'$(MSBuildProjectName)' == 'BG3Extender' Or '$(MSBuildProjectName)' == 'LuaDebugger'">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(BG3SEPairSourceCommit)', '^[0-9a-f]{40}$'))"
           Text="Set BG3SEPairSourceCommit or BG3SE_PAIR_SOURCE_COMMIT to the full custom source commit." />
  </Target>

  <Target Name="GenerateDebuggerPairIdentity" DependsOnTargets="ValidateBG3SEPairIdentity" Condition="'$(MSBuildProjectName)' == 'BG3Extender' Or '$(MSBuildProjectName)' == 'LuaDebugger'">
    <WriteLinesToFile Condition="'$(MSBuildProjectName)' == 'BG3Extender'"
                      File="$(ProjectDir)Lua\Debugger\DebuggerPairIdentity.g.h"
                      Lines="#pragma once%0A#define BG3SE_DEBUGGER_PAIR_IDENTITY &quot;$(BG3SEPairIdentity)&quot;"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile Condition="'$(MSBuildProjectName)' == 'LuaDebugger'"
                      File="$(ProjectDir)DebuggerPairIdentity.g.cs"
                      Lines="namespace NSE.DebuggerFrontend { internal static class DebuggerPairIdentity { internal const string Value = &quot;$(BG3SEPairIdentity)&quot;%3B } }"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="GenerateDebuggerBuildInputs" BeforeTargets="PrepareForBuild" DependsOnTargets="GenerateDebuggerPairIdentity" Condition="'$(MSBuildProjectName)' == 'BG3Extender' Or '$(MSBuildProjectName)' == 'LuaDebugger'" />
</Project>
